{
  "manifest_version": 3,
  "name": "AFTERCLICK — Interface Flight Recorder",
  "short_name": "AFTERCLICK",
  "version": "0.1.0",
  "description": "Record what happens after a click. Inspect real interface states and timing in the AFTERCLICK Studio.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AFTERCLICK — record this tab",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period",
        "mac": "MacCtrl+Shift+Period"
      },
      "description": "Open the AFTERCLICK recorder"
    }
  }
}
